---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';

import type { PlatformComponent } from '../data/components';
import { resolveEmbedSrc, resolveExternalUrl } from '../data/components';

interface Props {
  component: PlatformComponent;
  // Deep-link path-met-query relatief aan de service-root. Bijvoorbeeld
  // "/dashboard/list/?filters=(slug:wia-funnel)" voor Superset.
  deepLink?: string | null;
}

const { component, deepLink = null } = Astro.props;

// Build-time resolutie. De Layout's runtime TLD-rewrite swap't *.uwv-platform.local
// op cloud-hosts naar de juiste TLD; we doen hetzelfde voor iframe-src
// hieronder in <script> zodat AKS/StackIT-bezoekers ook werken.
const embedSrc = resolveEmbedSrc(component, deepLink);
const externalUrl = resolveExternalUrl(component, deepLink);
const canEmbed = embedSrc !== null;
---
<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="same-origin" />
    <title>{component.name} · UWV Platform Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('uwv-portal-theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = saved ?? (prefersLight ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) { /* localStorage onbeschikbaar */ }
      })();
    </script>
  </head>
  <body class="embed-body">
    <header class="embed-topbar">
      <div class="embed-topbar-left">
        <a class="embed-back" href="/" title="Terug naar portal" aria-label="Terug naar portal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
          <span class="embed-back-label">Portal</span>
        </a>
        <span class="embed-divider" aria-hidden="true">/</span>
        <span class="embed-service">
          <img class="embed-service-icon" src={component.icon} alt="" width="18" height="18" />
          <span class="embed-service-name">{component.name}</span>
        </span>
        {deepLink && (
          <>
            <span class="embed-divider" aria-hidden="true">/</span>
            <span class="embed-deep mono" title={deepLink}>{deepLink}</span>
          </>
        )}
      </div>
      <div class="embed-topbar-right">
        {externalUrl && (
          <a class="embed-btn" id="embed-open-external"
             href={externalUrl}
             target="_blank" rel="noopener noreferrer"
             title="Open in nieuw tabblad">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 3h7v7M10 14L21 3M21 14v7H3V3h7"/>
            </svg>
            <span>Nieuw tabblad</span>
          </a>
        )}
        {canEmbed && (
          <button class="embed-btn" type="button" id="embed-fullscreen"
                  title="Volledig scherm (verberg balk)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9V3h6M21 9V3h-6M3 15v6h6M21 15v6h-6"/>
            </svg>
            <span>Volledig</span>
          </button>
        )}
      </div>
    </header>

    {canEmbed ? (
      <iframe
        id="embed-frame"
        class="embed-frame"
        src={embedSrc}
        title={component.name}
        allow="clipboard-write; fullscreen"
        referrerpolicy="same-origin"
      ></iframe>
    ) : (
      <div class="embed-fallback">
        <div class="embed-fallback-card">
          <h1>{component.name} is niet inline embed-baar</h1>
          <p>{component.purpose}</p>
          <p class="embed-fallback-reason">
            {component.embed?.mode === 'none'
              ? 'Deze service heeft geen iframe-veilige UI (login-redirects of admin-flow).'
              : 'Geen iframe-URL beschikbaar voor deze omgeving.'}
          </p>
          {externalUrl && (
            <a class="embed-btn embed-btn-primary" href={externalUrl}
               target="_blank" rel="noopener noreferrer">
              <span>Open {component.name} in nieuw tabblad</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3h7v7M10 14L21 3M21 14v7H3V3h7"/>
              </svg>
            </a>
          )}
          <a class="embed-back-link" href="/">← Terug naar portal</a>
        </div>
      </div>
    )}

    <script>
      // ─── TLD-rewrite voor iframe-src en open-in-new-tab op cloud-hosts.
      // Build-time URLs zijn https://<svc>.uwv-platform.local:8443/...; op
      // *.eu-sovereigndataplatform.com of *.freshstackable.com swappen we
      // de host en droppen de :8443 (cloud LB op 443).
      (function () {
        var host = window.location.hostname;
        var CLOUD_TLDS = ['eu-sovereigndataplatform.com', 'freshstackable.com'];
        var targetTld = null;
        for (var t = 0; t < CLOUD_TLDS.length; t++) {
          if (host === CLOUD_TLDS[t] || host.endsWith('.' + CLOUD_TLDS[t])) {
            targetTld = CLOUD_TLDS[t]; break;
          }
        }
        if (!targetTld) return;
        var KEEP_LOCAL = ['multica', 'nanitics'];

        function rewriteHref(href: string): string {
          var m = href.match(/:\/\/([a-z0-9-]+)\.uwv-platform\.local(:8443)?/);
          if (m && KEEP_LOCAL.indexOf(m[1]) !== -1) return href;
          return href
            .replace(/:\/\/([a-z0-9-]+)\.uwv-platform\.local(:8443)?/g,
                     '://$1.' + targetTld);
        }

        var iframe = document.getElementById('embed-frame') as HTMLIFrameElement | null;
        if (iframe && iframe.src) iframe.src = rewriteHref(iframe.src);
        var anchors = document.querySelectorAll<HTMLAnchorElement>('a[href*="uwv-platform.local"]');
        for (var i = 0; i < anchors.length; i++) anchors[i].href = rewriteHref(anchors[i].href);
      })();

      // ─── Volledig-scherm toggle. Verbergt de top-bar; klik nogmaals
      //     om terug te keren. Esc werkt ook als de iframe focus heeft.
      var fsBtn = document.getElementById('embed-fullscreen');
      var body = document.body;
      function exitFull(): void { body.classList.remove('embed-full'); }
      fsBtn?.addEventListener('click', function () {
        body.classList.toggle('embed-full');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && body.classList.contains('embed-full')) {
          e.preventDefault();
          exitFull();
        }
      });
    </script>

    <style is:global>
      :root, [data-theme="dark"], [data-theme="light"] {
        /* Inherit theme tokens from base.css/tokens.css */
      }

      html, body { height: 100%; margin: 0; padding: 0; }
      body.embed-body {
        background: var(--bg);
        color: var(--ink-1);
        font-family: var(--font-sans);
        display: grid;
        grid-template-rows: auto 1fr;
        overflow: hidden;
      }

      .embed-topbar {
        background: var(--bg-elev);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        gap: var(--space-3);
        min-height: 40px;
        z-index: 10;
        transition: transform 0.2s, opacity 0.2s;
      }
      .embed-topbar-left,
      .embed-topbar-right {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-width: 0;
      }
      .embed-topbar-left { flex: 1; min-width: 0; }

      .embed-back {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--ink-2);
        text-decoration: none;
        padding: 4px 8px;
        border-radius: var(--radius-sm);
        font-size: var(--text-meta);
        line-height: 1;
        transition: background 0.15s, color 0.15s;
      }
      .embed-back:hover {
        background: var(--bg-sunken);
        color: var(--ink-1);
        text-decoration: none;
      }
      .embed-back-label { font-weight: var(--weight-medium); }

      .embed-divider {
        color: var(--ink-4);
        font-size: var(--text-meta);
      }

      .embed-service {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--ink-1);
        font-size: var(--text-meta);
      }
      .embed-service-icon {
        display: block;
        flex-shrink: 0;
      }
      .embed-service-name { font-weight: var(--weight-medium); }

      .embed-deep {
        color: var(--ink-3);
        font-size: var(--text-micro);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 40ch;
      }

      .embed-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        padding: 4px 10px;
        background: var(--bg);
        color: var(--ink-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        font-size: var(--text-micro);
        line-height: 1;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .embed-btn:hover {
        background: var(--bg-elev);
        color: var(--ink-1);
        border-color: var(--ink-4);
        text-decoration: none;
      }
      .embed-btn-primary {
        background: var(--accent);
        color: var(--accent-ink);
        border-color: var(--accent);
        font-size: var(--text-meta);
        padding: 8px 14px;
      }
      .embed-btn-primary:hover {
        background: var(--accent);
        color: var(--accent-ink);
        opacity: 0.92;
      }

      .embed-frame {
        width: 100%;
        height: 100%;
        border: 0;
        background: var(--bg-sunken);
        display: block;
      }

      /* Volledig-scherm: top-bar offscreen, iframe pakt alles. */
      body.embed-full .embed-topbar {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
        position: absolute;
        top: 0; left: 0; right: 0;
      }
      body.embed-full {
        grid-template-rows: 1fr;
      }

      .embed-fallback {
        display: grid;
        place-items: center;
        padding: var(--space-7);
        background: var(--bg);
      }
      .embed-fallback-card {
        max-width: 480px;
        text-align: left;
        background: var(--bg-elev);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        padding: var(--space-6);
        display: grid;
        gap: var(--space-3);
      }
      .embed-fallback-card h1 {
        font-size: var(--text-h3);
        margin: 0;
        border: 0;
        padding: 0;
        color: var(--ink-1);
      }
      .embed-fallback-card p { margin: 0; color: var(--ink-2); }
      .embed-fallback-reason {
        font-size: var(--text-meta);
        color: var(--ink-3);
        font-style: italic;
      }
      .embed-back-link {
        color: var(--ink-3);
        font-size: var(--text-meta);
        margin-top: var(--space-2);
      }

      @media (max-width: 640px) {
        .embed-back-label { display: none; }
        .embed-deep { max-width: 18ch; }
        .embed-btn span { display: none; }
      }
    </style>
  </body>
</html>
