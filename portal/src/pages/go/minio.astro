---
import ShellLayout from '../../layouts/ShellLayout.astro';
---
<ShellLayout title="MinIO Console — embed" activeSection="catalog">
  <section class="panel">
    <h1>Doorsturen naar MinIO Console…</h1>
    <p id="status">Openen in portal-shell…</p>
    <p id="fallback" hidden>
      Automatisch doorsturen mislukte. Open <a href="/embed/minio/">MinIO Console</a> direct.
    </p>
  </section>

  <script>
    // /go/minio/ blijft staan voor backwards-compat van bestaande bookmarks
    // en interne shortcuts (role-shortcuts.ts). Met de embed-shell sturen
    // we user nu door naar /embed/minio/ — dat iframe't direct de Console
    // (embed.iframeBase = minio-console.uwv-platform.local:8443), waar
    // moderne MinIO-builds zelf SSO-redirect aanbieden via /api/v1/login.
    // De oude in-cluster proxy-bootstrap (`/api/minio-sso/login`) is niet
    // meer nodig voor de UI-flow.
    setTimeout(() => {
      const fb = document.getElementById('fallback');
      if (fb) fb.hidden = false;
    }, 2000);
    window.location.replace('/embed/minio/');
  </script>
</ShellLayout>
