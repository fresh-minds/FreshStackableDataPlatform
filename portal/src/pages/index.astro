---
/*
  Home (/) — v2 workspace homepage.

  Renders the v2 shell (left rail, top bar, command palette) wrapped
  around the shared WorkspaceHome component. The legacy hero ("Eén
  platform voor data — elf rollen, één bron van waarheid") and the
  status-card landing has been superseded by the v2 workspace model;
  the architecture diagram is still reachable via /me/.

  In fase 2 persona-greeting will become live (oauth2-proxy identity);
  for now it falls back to the default from src/data/v2-homepage.ts.

  The legacy Layout.astro stays in the repo for /me/, /access-request/,
  /csv-upload/, /styleguide/ and the embed shell — each migrates in
  later steps. ShellLayout is opt-in per page.
*/
import ShellLayout from '../layouts/ShellLayout.astro';
import WorkspaceHome from '../components/shell/WorkspaceHome.astro';
---

<ShellLayout
  title="Home"
  activeSection="home"
>
  <WorkspaceHome />
</ShellLayout>
