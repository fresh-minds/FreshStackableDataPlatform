# UDP Portal backend — FastAPI service voor /api/portal/*.
# Persistent SQLite-store voor recents + favorites per ingelogde
# gebruiker. State leeft op een PVC die aan de Pod gemount wordt
# op /var/lib/portal-backend; bij destroy van de Pod blijft de
# database staan (PVC overleeft).

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORTAL_DB_PATH=/var/lib/portal-backend/portal.db

RUN pip install --no-cache-dir \
    'fastapi==0.115.*' \
    'uvicorn[standard]==0.32.*' \
    'pydantic==2.9.*' \
    'httpx==0.27.*'

# Houd dezelfde module-pad als learn-backend zodat de K8s-deployment
# dezelfde import-string kan gebruiken: portal.scripts.portal-backend:app.
# Bestand bevat een dash, dus bij COPY hernoemen naar underscore-vorm
# zodat Python het kan importeren.
COPY scripts/portal-backend.py /app/portal/scripts/portal_backend.py
RUN mkdir -p /app/portal /var/lib/portal-backend \
 && touch /app/portal/__init__.py /app/portal/scripts/__init__.py

# Non-root: 1000:1000 = standard Stackable pattern. Mount PVC moet
# read/write zijn voor deze UID; zie deployment fsGroup.
RUN useradd --system --uid 1000 --gid 0 portal && chown -R 1000:0 /var/lib/portal-backend
USER 1000

EXPOSE 8089

CMD ["uvicorn", "portal.scripts.portal_backend:app", "--host", "0.0.0.0", "--port", "8089"]
